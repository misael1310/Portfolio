{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write .",
      "prettier --check .",
      "npm run lint --fix"
    ]
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "preview": "vite preview",
    "test": "vitest run",
    "prepare": "husky install"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "@tailwindcss/typography": "^0.5.15",
    "classnames": "^2.5.1",
    "dompurify": "^3.4.7",
    "html-react-parser": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router": "^7.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.9.0",
    "@types/classnames": "^2.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
